parameters:
    level: max
    phpVersion:
        min: 80600
        max: 80699
    paths:
        - PushBundle.php
        - Attribute
        - DependencyInjection
        - Dispatcher
        - EventListener
        - Factory
        - Message
        - MessageHandler
        - Service
        - Tests
        - rector.php
    treatPhpDocTypesAsCertain: false
